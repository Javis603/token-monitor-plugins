{
  "tmApi": 1,
  "id": "codingpass",
  "name": {
    "en": "CodingPass",
    "zh-CN": "CodingPass",
    "zh-TW": "CodingPass"
  },
  "description": {
    "en": "Show CodingPass 5-hour, weekly and monthly allowance usage, read from the codingpass.ai console with a manually supplied session cookie.",
    "zh-CN": "使用手动提供的 codingpass.ai 控制台登录 Cookie，显示 CodingPass 的 5 小时、每周、每月额度用量。",
    "zh-TW": "使用手動提供的 codingpass.ai 控制台登入 Cookie，顯示 CodingPass 的 5 小時、每週、每月額度用量。"
  },
  "version": "0.1.0",
  "author": "ZC-TigerRoot",
  "homepage": "https://github.com/Javis603/token-monitor-plugins/tree/main/plugins/codingpass",
  "ui": "settings.mjs",
  "backend": "backend.cjs",
  "files": [
    "backend.cjs",
    "usage.cjs",
    "settings.mjs",
    "LICENSE",
    "CHANGELOG.md",
    "CHANGELOG.zh-CN.md",
    "CHANGELOG.zh-TW.md",
    "CHANGELOG.ko.md",
    "CHANGELOG.ja.md",
    "CHANGELOG.pt-BR.md",
    "README.md",
    "README.zh-CN.md",
    "README.zh-TW.md",
    "README.ko.md",
    "README.ja.md",
    "README.pt-BR.md"
  ],
  "views": [
    {
      "id": "setup",
      "title": {
        "en": "CodingPass setup",
        "zh-CN": "CodingPass 设置",
        "zh-TW": "CodingPass 設定"
      },
      "surfaces": [
        "settings"
      ]
    }
  ],
  "limits": [
    {
      "id": "plan",
      "name": "CodingPass",
      "capabilities": [
        "web"
      ],
      "settingsView": "setup",
      "credentials": {
        "validation": true,
        "fields": [
          {
            "id": "cookie",
            "label": {
              "en": "Console Cookie header",
              "zh-CN": "控制台 Cookie 请求头",
              "zh-TW": "控制台 Cookie 請求標頭"
            },
            "control": "textarea",
            "required": true
          }
        ]
      }
    }
  ],
  "presentation": {
    "icon": {
      "data": "data:image/svg+xml;base64,",
      "mode": "mask"
    },
    "color": {
      "hex": "#ff5a1f"
    }
  },
  "engines": {
    "tokenMonitor": ">=0.88.0"
  },
  "identityIcon": "data:image/png;base64,"
}
