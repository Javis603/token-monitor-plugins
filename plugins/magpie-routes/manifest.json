  "views": [
    {
      "id": "routes",
      "title": {
        "en": "Magpie Routes",
        "zh-TW": "Magpie 路由",
        "zh-CN": "Magpie 路由"
      },
      "surfaces": [
        "page",
        "edgeDock",
        "notch"
      ],
      "defaultSurfaces": [
        "page",
        "notch",
        "edgeDock"
      ]
    }
  ],
  "settings": {
    "version": 1,
    "fields": [
      {
        "id": "port",
        "type": "number",
        "label": {
          "en": "Magpie port",
          "zh-TW": "Magpie 連接埠",
          "zh-CN": "Magpie 端口"
        },
        "description": {
          "en": "0: auto-detect from local Magpie settings; otherwise use 3425. Localhost only.",
          "zh-TW": "0：自動讀取本機 Magpie 設定，未設定時使用 3425。只連接本機。",
          "zh-CN": "0：自动读取本机 Magpie 设置，未设置时使用 3425。只连接本机。"
        },
        "default": 0,
        "integer": true,
        "min": 0,
        "max": 65535
      },
      {
        "id": "maskAccounts",
        "type": "boolean",
        "label": {
          "en": "Hide account names",
          "zh-TW": "將帳號名稱打碼",
          "zh-CN": "将账号名称打码"
        },
        "default": true,
        "description": {
          "en": "Shared by the main page, Notch and Dock. Changes are saved.",
          "zh-TW": "主頁、Notch 與 Dock 共用，切換後自動儲存。",
          "zh-CN": "主页、Notch 与 Dock 共用，切换后自动保存。"
        }
      }
    ]
  },
  "identityIcon": "data:image/png;base64,",
